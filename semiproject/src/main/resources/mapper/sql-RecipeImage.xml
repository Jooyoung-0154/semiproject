<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper SYSTEM "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.cloud.mapper.RecipeImageMapper">

    <!-- 이미지 등록 -->
    <insert id="insertRecipeImage">
        INSERT INTO recipe_image (RECIPE_CODE, SORT_ORDER, IMG_URL)
        VALUES (#{recipeCode}, #{sortOrder}, #{imgUrl})
    </insert>

    <!-- 레시피별 이미지 목록 조회 (순서 정렬 필수!) -->
    <select id="getImagesByRecipeCode" resultType="org.cloud.dto.RECIPE_IMAGE">
        SELECT * FROM recipe_image 
        WHERE RECIPE_CODE = #{recipeCode}
        ORDER BY SORT_ORDER ASC
    </select>

    <!-- 특정 레시피 이미지 일괄 삭제 -->
    <delete id="deleteImagesByRecipeCode">
        DELETE FROM recipe_image 
        WHERE RECIPE_CODE = #{recipeCode}
    </delete>

</mapper>